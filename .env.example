# Groq Cloud API Configuration
# Get your free or enterprise API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile)
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

